# 环境变量模板：复制为 .env 后按需修改
# cp .env.example .env

# ---- 数据库 ----
# 默认 SQLite 零配置（数据文件落在 ./data/yoga.db，由 docker volume 持久化）
DATABASE_URL=sqlite:///./data/yoga.db
# 切换 Postgres 示例：DATABASE_URL=postgresql://yoga:你的密码@db:5432/yoga
# （需在 docker-compose.yml 中另加 postgres 服务）

# 上传文件目录
UPLOAD_DIR=./data/uploads

# ---- 安全 ----
# JWT 签名密钥：生产环境务必改为随机长字符串
SECRET_KEY=请修改为随机长字符串
# Token 有效期（分钟），默认 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 运行环境：dev（开发，默认）/ prod（生产）
# 生产模式下如 SECRET_KEY / ADMIN_PASSWORD 仍是默认值，或未设 DATA_ENC_KEY，
# 应用启动时直接报错退出
ENV=dev
# 或用 PROD=true 开启生产模式（与 ENV=prod 等效）
# PROD=false

# CORS 白名单（逗号分隔）：生产环境改为 Web 管理端真实域名（小程序不受跨域限制）
# 线上域名 zytzml.cn：Web 后台 www，接口 api
CORS_ORIGINS=https://www.zytzml.cn,https://zytzml.cn,http://localhost:5173,http://127.0.0.1:5173

# 上传文件大小上限（字节），默认 10MB
# MAX_UPLOAD_BYTES=10485760

# ---- 默认馆主账号（首次启动自动创建）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请修改

# ---- 第三方 API（密钥只能写在这里，绝不写进代码或提交到仓库）----
OCR_API_URL=
OCR_API_KEY=
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# ---- 微信小程序登录（公众平台 mp.weixin.qq.com → 开发管理 → 开发设置）----
# 不配置时小程序仍可用账号密码登录；配置后支持微信免密登录
WX_APPID=
WX_SECRET=
# 开发/CI 联调用：true 时 wx.login 的 code 传 "mock:任意标识" 即可换 mock openid。
# 生产环境必须关闭（开启时启动检查会报错）
WX_DEV_MOCK=false

# ---- 签到时间窗（分钟）----
# 客户扫码签到仅允许开课前 30 分钟 ~ 开课后 60 分钟内；教练手动补签不受限
# CHECKIN_OPEN_MIN=30
# CHECKIN_CLOSE_MIN=60
