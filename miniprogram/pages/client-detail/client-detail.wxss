/* 客户详情：复用 app.wxss 全局 token，此处仅补操作按钮与趋势 tab */
.ops { display: flex; gap: 16rpx; margin: 24rpx 0 6rpx; }
.op-btn { flex: 1; background: #fff; border-radius: 999rpx; font-size: 28rpx; height: 84rpx; line-height: 84rpx; color: #2F3F3C; box-shadow: 0 4rpx 16rpx rgba(122,100,84,.06); }
.op-btn::after { border: none; }
.tabs { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.tab { font-size: 24rpx; padding: 10rpx 24rpx; border-radius: 999rpx; background: #F1E9DE; color: #85948F; }
.tab.on { background: #357771; color: #fff; }
.trend-canvas { width: 100%; height: 300rpx; }
.hist-row { padding: 22rpx 28rpx; margin-bottom: 16rpx; }
