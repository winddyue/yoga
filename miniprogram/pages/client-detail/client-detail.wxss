/* 客户详情：复用 app.wxss 全局 token，此处仅补操作按钮与趋势 tab */
.ops { display: flex; gap: 16rpx; margin: 24rpx 0 6rpx; }
.op-btn { flex: 1; background: #fff; border-radius: 999rpx; font-size: 28rpx; height: 84rpx; line-height: 84rpx; color: #2F3F3C; box-shadow: 0 4rpx 16rpx rgba(122,100,84,.06); }
.op-btn::after { border: none; }
.tabs { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.tab { font-size: 24rpx; padding: 10rpx 24rpx; border-radius: 999rpx; background: #F1E9DE; color: #85948F; }
.tab.on { background: #357771; color: #fff; }
.trend-canvas { width: 100%; height: 300rpx; }
.hist-row { padding: 22rpx 28rpx; margin-bottom: 16rpx; }

/* 最新状态：两列网格 */
.status-grid { display: flex; flex-wrap: wrap; padding: 8rpx 28rpx 20rpx; }
.status-cell { width: 50%; padding: 18rpx 0; border-bottom: 2rpx solid #F0F0EC; }
.status-label { display: block; font-size: 24rpx; color: #85948F; margin-bottom: 6rpx; }
.status-value { display: block; font-size: 32rpx; font-weight: 600; color: #2F3F3C; }

/* 较上条对比 chip */
.delta-chip{display:inline-block;font-size:24rpx;padding:8rpx 22rpx;border-radius:999rpx;margin-top:10rpx}
.delta-good{background:#E3EFE3;color:#4C7A4C}
.delta-bad{background:#F8E4E0;color:#B4655F}
.delta-flat{background:#EDEFF0;color:#85948F}
