<view class="container t-{{theme}}">
  <view class="title">团购商城</view>
  <view wx:if="{{loading}}" class="tip">加载中…</view>
  <view wx:elif="{{!products.length}}" class="tip">暂无在售商品</view>
  <view wx:else wx:for="{{products}}" wx:key="id" class="card">
    <view class="t">{{item.name}}</view>
    <view wx:if="{{item.description}}" class="desc">{{item.description}}</view>
    <view class="buy-row">
      <text class="price">{{item.priceText}}</text>
      <button size="mini" type="primary" data-id="{{item.id}}" bindtap="buy" loading="{{paying}}">立即购买</button>
    </view>
  </view>
</view>
