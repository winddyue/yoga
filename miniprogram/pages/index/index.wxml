<view class="home-page">
  <view class="home-head"><view><text class="eyebrow">今日状态</text><text class="title">我的进展</text></view><view class="avatar">瑜</view></view>
  <view wx:if="{{loading}}" class="tip">加载中…</view>
  <view wx:elif="{{loadErr}}" class="tip err">
    <view>{{loadErr}}</view>
    <button size="mini" bindtap="load">重试</button>
  </view>
  <view wx:elif="{{s}}" class="content">
    <view class="goal-card"><text class="label">当前目标</text><text class="goal">{{s.goal || '保持规律训练'}}</text><text class="goal-sub">坚持记录，进步看得见</text></view>
    <view class="stats"><view class="stat"><text class="stat-value">{{s.attendance_rate || 0}}%</text><text class="stat-label">出勤率</text></view><view class="stat"><text class="stat-value">{{s.weight_change || 0}}<text class="unit">kg</text></text><text class="stat-label">体重变化</text></view><view class="stat"><text class="stat-value">{{s.upcoming_bookings || 0}}</text><text class="stat-label">待上课程</text></view></view>
    <view class="section-title">下一步</view><navigator class="action" url="/pages/booking/booking"><view><text class="action-title">查看课程并预约</text><text class="action-sub">选一节适合你的课程</text></view><text class="arrow">›</text></navigator>
  </view>
  <view wx:else class="tip">暂无数据</view>
</view>
