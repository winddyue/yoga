<view class="home-page t-{{theme}}">
  <view class="home-head">
    <view>
      <text class="eyebrow">{{needLogin ? '欢迎光临' : '今日状态'}}</text>
      <text class="title">{{needLogin ? '瑜伽馆' : (user && user.role === 'coach' ? '教练工作台' : (user && user.role === 'owner' ? '经营概况' : '我的进展'))}}</text>
    </view>
    <view class="avatar">瑜</view>
  </view>

  <!-- 金刚区：登录后常驻首屏，按角色给不同快捷动作（替代此前埋 3 层的入口） -->
  <view wx:if="{{s && user}}" class="quick-grid">
    <block wx:if="{{user.role === 'owner' || user.role === 'coach'}}">
      <view class="quick-item" bindtap="goIntake">
        <view class="quick-icon qi-teal">AI</view>
        <text class="quick-label">智能录入</text>
      </view>
      <view class="quick-item" bindtap="goIntakePhoto">
        <view class="quick-icon qi-blue">📷</view>
        <text class="quick-label">拍照录入</text>
      </view>
      <view class="quick-item" bindtap="goNewClient">
        <view class="quick-icon qi-amber">＋</view>
        <text class="quick-label">新增客户</text>
      </view>
      <view class="quick-item" bindtap="goClients">
        <view class="quick-icon qi-green">☰</view>
        <text class="quick-label">客户管理</text>
      </view>
    </block>
    <block wx:else>
      <view class="quick-item" bindtap="quickPhotoCheckin">
        <view class="quick-icon qi-teal">📷</view>
        <text class="quick-label">拍照打卡</text>
      </view>
      <view class="quick-item" bindtap="goMeasure">
        <view class="quick-icon qi-amber">＋</view>
        <text class="quick-label">记录体测</text>
      </view>
      <view class="quick-item" bindtap="goTraining">
        <view class="quick-icon qi-green">☰</view>
        <text class="quick-label">我的计划</text>
      </view>
    </block>
  </view>

  <view wx:if="{{loading}}" class="tip">加载中…</view>

  <!-- 未登录：引导态，不强制跳转 -->
  <view wx:elif="{{needLogin}}" class="content">
    <view class="guest-card">
      <text class="guest-title">您好，请先登录</text>
      <text class="guest-sub">登录后查看训练计划和身体数据</text>
      <button class="guest-btn" bindtap="goLogin">登录 / 注册</button>
    </view>
    <!-- 约课功能暂隐：浏览课程入口恢复时取消注释
    <view class="section-title">先看看</view>
    <navigator class="action" open-type="switchTab" url="/pages/booking/booking">
      <view>
        <text class="action-title">浏览课程</text>
        <text class="action-sub">无需登录即可查看近期开课</text>
      </view>
      <text class="arrow">›</text>
    </navigator>
    -->
  </view>

  <view wx:elif="{{loadErr}}" class="tip err">
    <view>{{loadErr}}</view>
    <button size="mini" bindtap="load">重试</button>
  </view>

  <!-- 客户视图 -->
  <view wx:elif="{{s && user && user.role === 'client'}}" class="content">
    <view class="goal-card">
      <text class="label">当前目标</text>
      <text class="goal">{{s.goal || '保持规律训练'}}</text>
      <text class="goal-sub">坚持记录，进步看得见</text>
    </view>
    <view class="stats">
      <view class="stat"><text class="stat-value">{{s.attendancePct || 0}}<text class="unit">%</text></text><text class="stat-label">出勤率</text></view>
      <view class="stat"><text class="stat-value">{{s.weight_change || 0}}<text class="unit">kg</text></text><text class="stat-label">体重变化</text></view>
      <view class="stat"><text class="stat-value">{{checkinDays}}</text><text class="stat-label">本月打卡</text></view>
    </view>
    <view class="ring-card">
      <view class="ring-wrap">
        <canvas canvas-id="goalRing" class="ring-canvas" />
        <view class="ring-text"><text class="ring-pct">{{s.attendancePct}}%</text></view>
      </view>
      <view class="ring-info">
        <text class="client-name">出勤目标差距</text>
        <text class="client-sub">当前 {{s.attendancePct}}%，目标 100%，还差 {{100 - s.attendancePct}} 个百分点</text>
      </view>
    </view>
    <view class="section-title">身体趋势</view>
    <view class="chart-card" wx:if="{{charts && charts.trends && charts.trends.dates.length}}">
      <view class="tabs">
        <text class="tab {{metric === 'weight' ? 'tab-active' : ''}}" bindtap="switchMetric" data-m="weight">体重</text>
        <text class="tab {{metric === 'body_fat' ? 'tab-active' : ''}}" bindtap="switchMetric" data-m="body_fat">体脂</text>
      </view>
      <canvas canvas-id="trendCanvas" id="trendCanvas" class="trend-canvas" />
      <view class="more-link" bindtap="goMeasure">＋ 记录体测</view>
    </view>
    <view class="tip" wx:else>暂无评估数据，多测几次就有曲线了</view>
    <view class="section-title">下一步</view>
    <!-- 约课功能暂隐：恢复时取消注释
    <navigator class="action" open-type="switchTab" url="/pages/booking/booking">
      <view>
        <text class="action-title">查看课程并预约</text>
        <text class="action-sub">选一节适合你的课程</text>
      </view>
      <text class="arrow">›</text>
    </navigator>
    -->
    <navigator class="action" url="/pages/measure/measure">
      <view>
        <text class="action-title">记录体测数据</text>
        <text class="action-sub">体重、体脂、围度，生成你的身体趋势</text>
      </view>
      <text class="arrow">›</text>
    </navigator>
  </view>

  <!-- 教练视图 -->
  <view wx:elif="{{s && user && user.role === 'coach'}}" class="content">
    <view class="stats">
      <view class="stat" bindtap="goPendingDiets"><text class="stat-value">{{s.todos.pending_diets || 0}}</text><text class="stat-label">待确认饮食</text></view>
      <view class="stat" bindtap="goRiskClients"><text class="stat-value">{{s.todos.due_reassess || 0}}</text><text class="stat-label">需复测客户</text></view>
    </view>
    <view class="section-title">名下客户</view>
    <view wx:for="{{s.clients}}" wx:key="id" class="client-row" bindtap="goClientDetail" data-id="{{item.id}}">
      <view class="client-dot dot-{{item.status}}"></view>
      <view class="client-main">
        <text class="client-name">{{item.name}}</text>
        <text class="client-sub">{{item.goal || ''}} · 出勤{{item.attendancePct}}% · {{item.daysText}}</text>
      </view>
      <text class="client-action">{{item.action}}</text>
      <text class="client-arrow">›</text>
    </view>
    <view class="tip" wx:if="{{!s.clients || !s.clients.length}}">暂无客户</view>
  </view>

  <!-- 馆主视图 -->
  <view wx:elif="{{s && user && user.role === 'owner'}}" class="content">
    <view class="stats">
      <view class="stat" bindtap="goAllClients"><text class="stat-value">{{s.total_clients || 0}}</text><text class="stat-label">总客户</text></view>
      <view class="stat" bindtap="goActiveClients"><text class="stat-value">{{s.active_clients_30d || 0}}</text><text class="stat-label">近30天活跃</text></view>
      <view class="stat" bindtap="goPendingDiets"><text class="stat-value">{{pendingDiets}}</text><text class="stat-label">待确认饮食</text></view>
    </view>
    <view class="section-title">会员分层</view>
    <view class="funnel" wx:if="{{coachData}}">
      <view class="funnel-item fi-blue" bindtap="goSegment" data-seg="new">
        <text class="funnel-num">{{s.new_clients_30d || 0}}</text>
        <text class="funnel-label">新客</text>
      </view>
      <view class="funnel-item fi-green" bindtap="goSegment" data-seg="active">
        <text class="funnel-num">{{coachData.greenN}}</text>
        <text class="funnel-label">状态正常</text>
      </view>
      <view class="funnel-item fi-yellow" bindtap="goSegment" data-seg="dormant">
        <text class="funnel-num">{{coachData.yellowN}}</text>
        <text class="funnel-label">待跟进</text>
      </view>
      <view class="funnel-item fi-red" bindtap="goSegment" data-seg="risk">
        <text class="funnel-num">{{coachData.redN}}</text>
        <text class="funnel-label">需关注</text>
      </view>
    </view>
    <view class="section-title">客户阶段分布</view>
    <view class="chart-card" wx:if="{{coachData}}">
      <view class="stage-bar">
        <view class="seg seg-red" style="width:{{coachData.redPct}}%"></view>
        <view class="seg seg-yellow" style="width:{{coachData.yellowPct}}%"></view>
        <view class="seg seg-green" style="width:{{coachData.greenPct}}%"></view>
      </view>
      <view class="stage-legend">
        <text>🔴 需关注 {{coachData.redN}}</text>
        <text>🟡 待跟进 {{coachData.yellowN}}</text>
        <text>🟢 状态正常 {{coachData.greenN}}</text>
      </view>
    </view>
    <view class="sec-row" bindtap="goAllClients">
      <text class="section-title">客户管理</text>
      <text class="sec-more">全部 ›</text>
    </view>
    <view wx:for="{{coachData.clients}}" wx:key="id" class="client-row" wx:if="{{coachData}}" bindtap="goClientDetail" data-id="{{item.id}}">
      <view class="client-dot dot-{{item.status}}"></view>
      <view class="client-main">
        <text class="client-name">{{item.name}}</text>
        <text class="client-sub">出勤{{item.attendancePct}}% · {{item.daysText}}</text>
      </view>
      <text class="client-action">{{item.action}}</text>
      <text class="client-arrow">›</text>
    </view>
    <view class="tip" wx:if="{{!coachData || !coachData.clients.length}}">暂无客户</view>
  </view>

  <view wx:else class="tip">暂无数据</view>
</view>
