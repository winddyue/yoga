.home-page{min-height:100vh;background:#EFF6F4;padding:44rpx 32rpx;box-sizing:border-box}.home-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:38rpx}.eyebrow{display:block;color:#85948F;font-size:24rpx}.title{display:block;color:#2F3F3C;font-size:46rpx;font-weight:700;margin-top:8rpx}.avatar{width:76rpx;height:76rpx;line-height:76rpx;text-align:center;border-radius:50%;background:#E6F2F1;color:#357771;font-size:30rpx;font-weight:700}.content{display:block}.goal-card{background:linear-gradient(135deg,#4FA39B 0%,#357771 100%);border-radius:26rpx;padding:34rpx;color:#fff;box-shadow:0 16rpx 32rpx rgba(53,119,113,.2)}.label{display:block;opacity:.76;font-size:24rpx}.goal{display:block;font-size:42rpx;font-weight:700;margin-top:18rpx}.goal-sub{display:block;opacity:.8;font-size:24rpx;margin-top:10rpx}.stats{display:flex;gap:18rpx;margin:24rpx 0 42rpx}.stat{background:#fff;border-radius:28rpx;flex:1;padding:25rpx 12rpx;text-align:center;box-shadow:0 8rpx 24rpx rgba(122,100,84,.05)}.stat-value{display:block;color:#2F3F3C;font-size:34rpx;font-weight:700}.unit{font-size:22rpx;font-weight:400}.stat-label{display:block;color:#85948F;font-size:23rpx;margin-top:10rpx}.section-title{font-size:30rpx;color:#2F3F3C;font-weight:700;margin-bottom:16rpx}.action{display:flex;justify-content:space-between;align-items:center;background:#fff;border-radius:28rpx;padding:28rpx 26rpx;box-shadow:0 8rpx 24rpx rgba(122,100,84,.05)}.action-title{display:block;color:#2F3F3C;font-size:29rpx;font-weight:600}.action-sub{display:block;color:#85948F;font-size:23rpx;margin-top:8rpx}.arrow{color:#357771;font-size:46rpx}.tip{text-align:center;color:#85948F;padding:80rpx 20rpx}.err{color:#B4655F}
/* 图表/客户行（汇总页新增） */
.chart-card{background:#fff;border-radius:28rpx;padding:26rpx;margin-bottom:36rpx;box-shadow:0 8rpx 24rpx rgba(122,100,84,.05)}
.trend-canvas{width:100%;height:300rpx}
.tabs{display:flex;gap:14rpx;margin-bottom:10rpx}
.tab{font-size:24rpx;color:#85948F;background:#F5EFE5;border-radius:999rpx;padding:10rpx 28rpx}
.tab-active{color:#fff;background:#357771}
.client-row{display:flex;align-items:center;background:#fff;border-radius:28rpx;padding:26rpx;margin-bottom:16rpx;box-shadow:0 8rpx 24rpx rgba(122,100,84,.05)}
.client-dot{width:20rpx;height:20rpx;border-radius:50%;margin-right:20rpx;flex-shrink:0}
.dot-red{background:#D98880}.dot-yellow{background:#D9A85F}.dot-green{background:#9CAF88}
.client-main{flex:1;display:flex;flex-direction:column}
.client-name{color:#2F3F3C;font-size:29rpx;font-weight:600}
.client-sub{color:#85948F;font-size:23rpx;margin-top:8rpx}
.client-action{color:#96690F;font-size:24rpx;flex-shrink:0;margin-left:16rpx}
.stage-bar{display:flex;height:28rpx;border-radius:999rpx;overflow:hidden;margin-bottom:16rpx}
.seg-red{background:#D98880}.seg-yellow{background:#D9A85F}.seg-green{background:#9CAF88}
.stage-legend{display:flex;gap:24rpx;font-size:24rpx;color:#2F3F3C}
/* 出勤目标圆环 */
.ring-card{display:flex;align-items:center;background:#fff;border-radius:28rpx;padding:26rpx;margin-bottom:36rpx;box-shadow:0 8rpx 24rpx rgba(122,100,84,.05)}
.ring-wrap{position:relative;width:120px;height:120px;flex-shrink:0}
.ring-canvas{width:120px;height:120px}
.ring-text{position:absolute;left:0;top:0;width:120px;height:120px;display:flex;align-items:center;justify-content:center}
.ring-pct{color:#357771;font-size:36rpx;font-weight:700}
.ring-info{margin-left:24rpx;display:flex;flex-direction:column}
/* 会员分层漏斗 */
.funnel{display:flex;gap:14rpx;margin-bottom:36rpx}
.funnel-item{flex:1;border-radius:18rpx;padding:22rpx 8rpx;text-align:center}
.funnel-num{display:block;font-size:38rpx;font-weight:700}
.funnel-label{display:block;font-size:23rpx;margin-top:8rpx;opacity:.75}
.fi-blue{background:#E6F2F1;color:#357771}
.fi-green{background:#EFF4EB;color:#5D6A4E}
.fi-yellow{background:#FBF3E2;color:#96690F}
.fi-red{background:#FBF0EE;color:#A85D5D}
