<view class="container t-{{theme}}">
  <view class="title">我的训练与饮食</view>

  <!-- 未登录：引导登录 -->
  <view wx:if="{{needLogin}}" class="login-bar" bindtap="goLogin">
    <text>登录后查看你的训练计划与饮食方案</text>
    <text class="go">去登录 ›</text>
  </view>

  <view wx:if="{{loading}}" class="tip">加载中…</view>
  <view wx:elif="{{loadErr}}" class="tip err">
    <view>{{loadErr}}</view>
    <button size="mini" bindtap="load">重试</button>
  </view>

  <!-- 全空：引导先记录体测 -->
  <view wx:elif="{{empty}}" class="empty-guide">
    <text class="empty-title">还没有数据</text>
    <text class="empty-sub">先记录一次体测吧，身体趋势曲线和训练建议就会出现</text>
    <button class="primary" bindtap="goMeasure">去记录体测</button>
  </view>

  <block wx:else>
    <!-- 健康仪表盘 -->
    <view class="dash">
      <view class="ring-wrap">
        <canvas canvas-id="trainRing" id="trainRing" class="ring-canvas" />
        <view class="ring-text"><text class="ring-pct">{{attPct}}%</text><text class="ring-label">出勤率</text></view>
      </view>
      <view class="stats">
        <view class="stat"><text class="stat-k">本月体测</text><text class="stat-v">{{monthCount}} 次</text></view>
        <view class="stat"><text class="stat-k">距上次评估</text><text class="stat-v">{{daysSince === null ? '—' : daysSince + ' 天'}}</text></view>
        <view class="stat"><text class="stat-k">进行中计划</text><text class="stat-v">{{plans.length}} 个</text></view>
      </view>
    </view>

    <!-- 本月总结 -->
    <view wx:if="{{summary}}" class="card summary-card">
      <view class="summary-text">{{summary.text}}</view>
      <view wx:if="{{summary.assess_count > 0}}" class="summary-nums">
        <view class="summary-num">
          <text class="n">{{summary.assess_count}}</text>
          <text class="k">体测（次）</text>
        </view>
        <view class="summary-num {{summary.weight_change < 0 ? 'wc-good' : (summary.weight_change > 0 ? 'wc-bad' : '')}}" wx:if="{{summary.weight_change !== null}}">
          <text class="n">{{summary.weight_change > 0 ? '+' : ''}}{{summary.weight_change}}<text class="u">kg</text></text>
          <text class="k">体重变化</text>
        </view>
        <view class="summary-num">
          <text class="n">{{summary.checkin_count}}</text>
          <text class="k">出勤（次）</text>
        </view>
      </view>
    </view>

    <view class="sec">身体趋势</view>
    <view class="chart-card" wx:if="{{charts && charts.trends && charts.trends.dates.length}}">
      <view class="tabs">
        <text class="tab {{metric === 'weight' ? 'tab-active' : ''}}" bindtap="switchMetric" data-m="weight">体重</text>
        <text class="tab {{metric === 'body_fat' ? 'tab-active' : ''}}" bindtap="switchMetric" data-m="body_fat">体脂</text>
        <text class="tab {{metric === 'waist' ? 'tab-active' : ''}}" bindtap="switchMetric" data-m="waist">腰围</text>
      </view>
      <view wx:if="{{delta}}" class="delta-row">
        <text class="delta-chip delta-{{deltaCls}}">较上次 {{delta.text}}</text>
      </view>
      <canvas canvas-id="trainTrend" id="trainTrend" class="trend-canvas" />
      <view class="more-link" bindtap="goMeasure">＋ 记录体测</view>
    </view>

    <view class="sec">训练计划（{{plans.length}}）</view>
    <view wx:if="{{!plans.length}}" class="tip">暂无训练计划</view>
    <view wx:for="{{plans}}" wx:key="id" class="card"><view class="t">第 {{item.week_start}} 周计划</view></view>
    <view class="sec">饮食方案（{{diets.length}}）</view>
    <view wx:if="{{!diets.length}}" class="tip">暂无饮食方案</view>
    <view wx:for="{{diets}}" wx:key="id" class="card">
      <view class="t">{{item.date}} · {{item.status === 'confirmed' ? '已确认' : (item.status === 'ai_draft' ? 'AI 生成·待教练确认' : '待确认')}}</view>
      <view wx:if="{{item.status === 'ai_draft'}}" class="disclaimer">AI 生成内容仅供参考，不构成医疗建议，请遵医嘱</view>
    </view>
  </block>
</view>
