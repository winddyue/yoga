<view class="container t-{{theme}}">
  <view class="title">{{role === 'staff' ? '训练管理' : '我的训练与饮食'}}</view>

  <!-- 未登录：引导登录 -->
  <view wx:if="{{needLogin}}" class="login-bar" bindtap="goLogin">
    <text>登录后查看你的训练计划与饮食方案</text>
    <text class="go">去登录 ›</text>
  </view>

  <view wx:if="{{loading}}" class="tip">加载中…</view>
  <view wx:elif="{{loadErr}}" class="tip err">
    <view>{{loadErr}}</view>
    <button size="mini" bindtap="load">重试</button>
  </view>

  <!-- 工作人员视图：待确认饮食 + 待办提醒 + 快捷入口 -->
  <block wx:elif="{{role === 'staff'}}">
    <view class="sec">待确认饮食（{{pendingDiets.length}}）</view>
    <view wx:if="{{!pendingDiets.length}}" class="tip">暂无待确认的饮食方案</view>
    <view wx:for="{{pendingDiets}}" wx:key="id" class="card">
      <view class="t">{{item.client_name}} · {{item.date}} · {{item.status === 'ai_draft' ? 'AI 生成' : '待确认'}}</view>
      <view class="sub">目标 {{item.calories_target}}千卡</view>
      <view class="btns">
        <button size="mini" type="primary" data-id="{{item.id}}" bindtap="confirmDiet">一键确认</button>
      </view>
    </view>

    <view class="sec">待办提醒</view>
    <view wx:if="{{dueReassess > 0}}" class="card">
      <view class="t">有 {{dueReassess}} 位客户需复测</view>
      <view class="btns">
        <button size="mini" bindtap="goClients">去看看</button>
      </view>
    </view>
    <view wx:else class="tip">暂无待办</view>

    <view class="sec">快捷入口</view>
    <view class="btn-row">
      <button bindtap="goClients">客户管理</button>
    </view>
  </block>

  <!-- 客户视图：全空引导 + 计划获取 -->
  <view wx:elif="{{role === 'client' && empty}}" class="empty-guide">
    <text class="empty-title">还没有数据</text>
    <text class="empty-sub">先记录一次体测吧，身体趋势曲线和训练建议就会出现</text>
    <button class="primary" bindtap="goMeasure">去记录体测</button>
    <view class="acquire-zone">
      <view class="sec">获取训练计划</view>
      <view class="btn-row">
        <button size="mini" type="primary" bindtap="aiGeneratePlan" loading="{{genPlan}}">AI 生成训练计划</button>
        <button size="mini" bindtap="requestPlan" data-kind="training">请求教练制定</button>
      </view>
      <view class="sec">获取饮食方案</view>
      <view class="btn-row">
        <button size="mini" type="primary" bindtap="aiGenerateDiet" loading="{{genDiet}}">AI 生成饮食方案</button>
        <button size="mini" bindtap="requestPlan" data-kind="diet">请求教练制定</button>
      </view>
    </view>
  </view>

  <block wx:elif="{{role === 'client'}}">
    <!-- 健康仪表盘 -->
    <view class="dash">
      <view class="ring-wrap">
        <canvas canvas-id="trainRing" id="trainRing" class="ring-canvas" />
        <view class="ring-text"><text class="ring-pct">{{attPct}}%</text><text class="ring-label">出勤率</text></view>
      </view>
      <view class="stats">
        <view class="stat"><text class="stat-k">本月体测</text><text class="stat-v">{{monthCount}} 次</text></view>
        <view class="stat"><text class="stat-k">距上次评估</text><text class="stat-v">{{daysSince === null ? '—' : daysSince + ' 天'}}</text></view>
        <view class="stat"><text class="stat-k">进行中计划</text><text class="stat-v">{{plans.length}} 个</text></view>
      </view>
    </view>

    <!-- 本月总结 -->
    <view wx:if="{{summary}}" class="card summary-card">
      <view class="summary-text">{{summary.text}}</view>
      <view wx:if="{{summary.assess_count > 0}}" class="summary-nums">
        <view class="summary-num">
          <text class="n">{{summary.assess_count}}</text>
          <text class="k">体测（次）</text>
        </view>
        <view class="summary-num {{summary.weight_change < 0 ? 'wc-good' : (summary.weight_change > 0 ? 'wc-bad' : '')}}" wx:if="{{summary.weight_change !== null}}">
          <text class="n">{{summary.weight_change > 0 ? '+' : ''}}{{summary.weight_change}}<text class="u">kg</text></text>
          <text class="k">体重变化</text>
        </view>
        <view class="summary-num">
          <text class="n">{{summary.checkin_count}}</text>
          <text class="k">出勤（次）</text>
        </view>
      </view>
    </view>

    <view class="sec">身体趋势</view>
    <view class="chart-card" wx:if="{{charts && charts.trends && charts.trends.dates.length}}">
      <view class="tabs">
        <text class="tab {{metric === 'weight' ? 'tab-active' : ''}}" bindtap="switchMetric" data-m="weight">体重</text>
        <text class="tab {{metric === 'body_fat' ? 'tab-active' : ''}}" bindtap="switchMetric" data-m="body_fat">体脂</text>
        <text class="tab {{metric === 'waist' ? 'tab-active' : ''}}" bindtap="switchMetric" data-m="waist">腰围</text>
      </view>
      <view wx:if="{{delta}}" class="delta-row">
        <text class="delta-chip delta-{{deltaCls}}">较上次 {{delta.text}}</text>
      </view>
      <canvas canvas-id="trainTrend" id="trainTrend" class="trend-canvas" />
      <view class="more-link" bindtap="goMeasure">＋ 记录体测</view>
    </view>

    <!-- 打卡区：登录客户始终显示 -->
    <view class="sec">今日打卡</view>
    <view class="card">
      <view class="btn-row">
        <button wx:if="{{!todayTraining}}" size="mini" type="primary" bindtap="checkin" data-kind="training">训练打卡</button>
        <button wx:else size="mini" disabled>✓ 训练已打卡</button>
        <button wx:if="{{!todayDiet}}" size="mini" type="primary" bindtap="checkin" data-kind="diet">饮食打卡</button>
        <button wx:else size="mini" disabled>✓ 饮食已打卡</button>
      </view>
    </view>
    <view class="sec">本月打卡 {{checkinDays}} 天</view>
    <view wx:if="{{!recentCheckins.length}}" class="tip">本月还没有打卡记录</view>
    <view wx:for="{{recentCheckins}}" wx:key="id" class="card">
      <view class="t">{{item.date}} · {{item.kindText}} <text wx:if="{{item.photo_path}}" data-path="{{item.photo_path}}" bindtap="previewPhoto">📷</text></view>
      <view wx:if="{{item.note}}" class="sub">{{item.note}}</view>
    </view>

    <view class="sec">训练计划（{{plans.length}}）</view>
    <view wx:if="{{!plans.length}}">
      <view class="tip">暂无训练计划</view>
      <view class="btn-row">
        <button size="mini" type="primary" bindtap="aiGeneratePlan" loading="{{genPlan}}">AI 生成训练计划</button>
        <button size="mini" bindtap="requestPlan" data-kind="training">请求教练制定</button>
      </view>
    </view>
    <view wx:for="{{plans}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="goPlanDetail">
      <view class="t">第 {{item.week_start}} 周计划 <text class="arrow">›</text></view>
      <view class="sub">{{item.days ? item.days.length : 0}} 天 · 点查看每天动作</view>
    </view>
    <view class="sec">饮食方案（{{diets.length}}）</view>
    <view wx:if="{{!diets.length}}">
      <view class="tip">暂无饮食方案</view>
      <view class="btn-row">
        <button size="mini" type="primary" bindtap="aiGenerateDiet" loading="{{genDiet}}">AI 生成饮食方案</button>
        <button size="mini" bindtap="requestPlan" data-kind="diet">请求教练制定</button>
      </view>
    </view>
    <view wx:for="{{diets}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="toggleDiet">
      <view class="t">{{item.date}} · {{item.status === 'confirmed' ? '已确认' : (item.status === 'ai_draft' ? 'AI 生成·待教练确认' : '待确认')}} <text class="arrow">{{expandedDiet === item.id ? '▾' : '›'}}</text></view>
      <view wx:if="{{item.status === 'ai_draft'}}" class="disclaimer">AI 生成内容仅供参考，不构成医疗建议，请遵医嘱</view>
      <view wx:if="{{expandedDiet === item.id}}" class="meals">
        <view wx:if="{{item.meals.breakfast}}" class="meal"><text class="mk">早餐</text>{{item.meals.breakfast.join('、')}}</view>
        <view wx:if="{{item.meals.lunch}}" class="meal"><text class="mk">午餐</text>{{item.meals.lunch.join('、')}}</view>
        <view wx:if="{{item.meals.dinner}}" class="meal"><text class="mk">晚餐</text>{{item.meals.dinner.join('、')}}</view>
        <view wx:if="{{item.meals.snack}}" class="meal"><text class="mk">加餐</text>{{item.meals.snack.join('、')}}</view>
        <view class="sub">{{item.calories_target}}千卡 · 蛋白{{item.protein_g}}g · 脂肪{{item.fat_g}}g · 碳水{{item.carbs_g}}g</view>
      </view>
    </view>
  </block>
</view>
