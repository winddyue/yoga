<view class="container">
  <view class="title">我的训练与饮食</view>
  <view wx:if="{{loading}}" class="tip">加载中…</view>
  <view wx:elif="{{loadErr}}" class="tip err">
    <view>{{loadErr}}</view>
    <button size="mini" bindtap="load">重试</button>
  </view>
  <block wx:else>
    <view class="sec">训练计划（{{plans.length}}）</view>
    <view wx:if="{{!plans.length}}" class="tip">暂无训练计划</view>
    <view wx:for="{{plans}}" wx:key="id" class="card"><view class="t">第 {{item.week_start}} 周计划</view></view>
    <view class="sec">饮食方案（{{diets.length}}）</view>
    <view wx:if="{{!diets.length}}" class="tip">暂无饮食方案</view>
    <view wx:for="{{diets}}" wx:key="id" class="card"><view class="t">{{item.date}} · {{item.status === 'confirmed' ? '已确认' : '待确认'}}</view></view>
  </block>
</view>
