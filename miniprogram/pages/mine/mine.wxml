<view class="mine-page t-{{theme}}">
  <!-- 头部：未登录显示登录引导，已登录显示头像与姓名 -->
  <view class="header" bindtap="onHeaderTap">
    <view class="avatar">{{user ? (user.name ? user.name[0] : '瑜') : '瑜'}}</view>
    <view class="who">
      <block wx:if="{{user}}">
        <text class="name">{{user.name || user.username}}</text>
        <text class="role">{{roleText}}</text>
      </block>
      <block wx:else>
        <text class="name">您好，请登录</text>
        <text class="role">登录后可预约课程、查看训练记录</text>
      </block>
    </view>
    <text wx:if="{{!user}}" class="go">登录 ›</text>
  </view>

  <!-- AI 会员订阅卡：客户可见；点进订阅页开通/续费 -->
  <view wx:if="{{user && user.role === 'client' && sub && !sub.active}}" class="promo-card" bindtap="goSubscribe">
    <view class="promo-tag">AI 会员</view>
    <view class="promo-title">开通 AI 会员</view>
    <view class="promo-sub">解锁 AI 训练计划、AI 饮食方案等智能功能</view>
    <view class="promo-go">立即开通 ›</view>
  </view>
  <view wx:if="{{user && user.role === 'client' && sub && sub.active}}" class="promo-card" bindtap="goSubscribe">
    <view class="promo-tag">AI 会员 · 已开通</view>
    <view class="promo-title">{{sub.planName || 'AI 会员'}}</view>
    <view wx:if="{{sub.expiresText}}" class="promo-sub">有效期至 {{sub.expiresText}}</view>
    <view class="promo-go">续费 ›</view>
  </view>

  <!-- 未登录：直接给登录/注册入口 -->
  <view wx:if="{{!user && !loading}}" class="login-box">
    <button class="primary" bindtap="goLogin">登录 / 注册</button>
    <text class="tip-text">首次使用将自动创建账号</text>
  </view>

  <!-- 已登录：功能列表 -->
  <view wx:if="{{user}}" class="menu">
    <view class="menu-item" bindtap="goProfile">
      <text>个人信息</text>
      <text class="arrow">›</text>
    </view>
    <view wx:if="{{user.role !== 'client'}}" class="menu-item" bindtap="goCoach">
      <text>教练工作台</text>
      <text class="arrow">›</text>
    </view>
    <!-- 约课功能暂隐（booking 恢复时取消注释）
    <view class="menu-item" data-tab="booking" bindtap="goRecords">
      <text>我的预约</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" data-tab="checkin" bindtap="goRecords">
      <text>签到记录</text>
      <text class="arrow">›</text>
    </view>
    -->
    <view wx:if="{{user.role === 'client'}}" class="menu-item" bindtap="goMeasure">
      <text>体测记录</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goOrders">
      <text>我的订单</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goNotices">
      <text>通知</text>
      <view class="right"><text wx:if="{{unread > 0}}" class="badge">{{unread > 99 ? '99+' : unread}}</text><text class="arrow">›</text></view>
    </view>
    <view class="menu-item" bindtap="goTheme">
      <text>界面风格</text>
      <text class="arrow">›</text>
    </view>
    <view wx:if="{{user.role === 'owner'}}" class="menu-item" bindtap="goUsers">
      <text>用户管理</text>
      <text class="arrow">›</text>
    </view>
    <view wx:if="{{user.role === 'owner'}}" class="menu-item" bindtap="goSettings">
      <text>系统设置</text>
      <text class="arrow">›</text>
    </view>
    <view wx:if="{{user.role === 'owner'}}" class="menu-item" bindtap="goFields">
      <text>自定义字段</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goAbout">
      <text>关于我们</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <button wx:if="{{user}}" class="logout" bindtap="logout">退出登录</button>
</view>
