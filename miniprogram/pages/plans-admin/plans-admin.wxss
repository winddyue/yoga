.bar { display: flex; justify-content: flex-end; margin-bottom: 8px; }
.link { color: #6F8563; font-size: 14px; font-weight: 600; }
.form .t { margin-bottom: 8px; }
.form .input { border: 1px solid #E4E8DD; border-radius: 8px; padding: 10px 12px; margin-bottom: 10px; font-size: 14px; background: #fff; }
.row { display: flex; align-items: center; justify-content: space-between; }
.badge { font-size: 11px; padding: 2px 10px; border-radius: 10px; }
.badge.on { background: #e3f2e6; color: #2e7d32; }
.badge.off { background: #f0ece4; color: #8A917F; }
.desc { font-size: 12px; color: #8A917F; margin-top: 4px; }
.btns { display: flex; gap: 8px; margin-top: 10px; }
button.sm { font-size: 14px; }
