<view class="container t-{{theme}}">
  <view class="title-row"><text class="title">代录体测{{clientName ? ' · ' + clientName : ''}}</text></view>

  <view wx:if="{{needLogin}}" class="login-bar" bindtap="goLogin">
    <text>登录后代录体测数据</text>
    <text class="go">去登录 ›</text>
  </view>

  <view wx:if="{{loading}}" class="tip">加载中…</view>
  <view wx:elif="{{loadErr}}" class="tip err">
    <view>{{loadErr}}</view>
    <button size="mini" bindtap="init">重试</button>
  </view>

  <block wx:elif="{{!needLogin}}">
    <!-- 客户尚未授权：工作人员可代登记 -->
    <view wx:if="{{needConsent}}" class="consent-bar">
      <text class="consent-text">该客户尚未完成敏感信息单独授权（合规要求），可代客户登记后再录入。</text>
      <button class="primary consent-btn" bindtap="agreeConsent" disabled="{{agreeing}}">{{agreeing ? '提交中…' : '代客户登记授权'}}</button>
    </view>

    <view class="card">
      <view class="field">
        <text class="label">日期</text>
        <picker mode="date" value="{{date}}" bindchange="onDateChange" class="value picker-value">
          <text>{{date}}</text>
          <text class="arrow">›</text>
        </picker>
      </view>
    </view>

    <view class="sec">身体成分</view>
    <view class="card">
      <view class="field">
        <text class="label">身高</text>
        <input class="value input" type="digit" placeholder="仅用于计算BMI" value="{{height}}" bindinput="onInput" data-k="height" />
        <text class="unit">cm</text>
      </view>
      <view class="field">
        <text class="label">体重 <text class="req">*</text></text>
        <input class="value input" type="digit" placeholder="如 62.5" value="{{weight}}" bindinput="onInput" data-k="weight" />
        <text class="unit">kg</text>
      </view>
      <view class="field">
        <text class="label">体脂率</text>
        <input class="value input" type="digit" placeholder="选填，如 27.5" value="{{bodyFat}}" bindinput="onInput" data-k="bodyFat" />
        <text class="unit">%</text>
      </view>
      <view class="field">
        <text class="label">肌肉量</text>
        <input class="value input" type="digit" placeholder="选填" value="{{muscle}}" bindinput="onInput" data-k="muscle" />
        <text class="unit">kg</text>
      </view>
      <view class="field">
        <text class="label">BMI</text>
        <text class="value input">{{bmiText || '—'}}</text>
        <text class="unit">自动计算</text>
      </view>
      <view class="field">
        <text class="label">内脏脂肪等级</text>
        <input class="value input" type="digit" placeholder="选填" value="{{visceral}}" bindinput="onInput" data-k="visceral" />
        <text class="unit">级</text>
      </view>
    </view>

    <view class="sec">围度</view>
    <view class="card">
      <view class="field">
        <text class="label">胸围</text>
        <input class="value input" type="digit" placeholder="选填" value="{{chest}}" bindinput="onInput" data-k="chest" />
        <text class="unit">cm</text>
      </view>
      <view class="field">
        <text class="label">腰围</text>
        <input class="value input" type="digit" placeholder="选填" value="{{waist}}" bindinput="onInput" data-k="waist" />
        <text class="unit">cm</text>
      </view>
      <view class="field">
        <text class="label">臀围</text>
        <input class="value input" type="digit" placeholder="选填" value="{{hip}}" bindinput="onInput" data-k="hip" />
        <text class="unit">cm</text>
      </view>
      <view class="field">
        <text class="label">上臂围</text>
        <input class="value input" type="digit" placeholder="选填" value="{{arm}}" bindinput="onInput" data-k="arm" />
        <text class="unit">cm</text>
      </view>
      <view class="field">
        <text class="label">大腿围</text>
        <input class="value input" type="digit" placeholder="选填" value="{{thigh}}" bindinput="onInput" data-k="thigh" />
        <text class="unit">cm</text>
      </view>
    </view>

    <view class="sec">健康指标</view>
    <view class="card">
      <view class="field">
        <text class="label">静息心率</text>
        <input class="value input" type="digit" placeholder="选填" value="{{restingHr}}" bindinput="onInput" data-k="restingHr" />
        <text class="unit">bpm</text>
      </view>
      <view class="field">
        <text class="label">血压</text>
        <input class="value input" placeholder="选填，如 120/80" value="{{bloodPressure}}" bindinput="onInput" data-k="bloodPressure" />
        <text class="unit">mmHg</text>
      </view>
      <view class="field">
        <text class="label">伤病史/注意事项</text>
        <input class="value input" placeholder="选填" value="{{injuries}}" bindinput="onInput" data-k="injuries" />
      </view>
      <view class="field">
        <text class="label">备注</text>
        <input class="value input" placeholder="选填" value="{{notes}}" bindinput="onInput" data-k="notes" />
      </view>
    </view>

    <button class="primary" bindtap="submit" disabled="{{submitting}}">{{submitting ? '保存中…' : '保存记录'}}</button>
  </block>
</view>
