<view class="container t-{{theme}}">
  <view wx:if="{{needLogin}}" class="login-bar" bindtap="goLogin">
    <text>登录后查看个人信息</text>
    <text class="go">去登录 ›</text>
  </view>

  <view wx:if="{{loading}}" class="tip">加载中…</view>

  <view wx:elif="{{loadErr}}" class="tip err">
    <view>{{loadErr}}</view>
    <button size="mini" bindtap="load">重试</button>
  </view>

  <block wx:elif="{{profile}}">
    <view class="card">
      <view class="sec">基本信息</view>

      <view class="field">
        <text class="label">姓名</text>
        <input class="value" placeholder="请填写姓名" data-k="name"
               value="{{form.name}}" bindinput="onInput" />
      </view>
      <view class="field">
        <text class="label">手机号</text>
        <input class="value" type="number" maxlength="11" placeholder="用于课程通知"
               data-k="phone" value="{{form.phone}}" bindinput="onInput" />
      </view>
      <view class="field">
        <text class="label">健身目标</text>
        <picker mode="selector" range="{{goals}}" value="{{goals.indexOf(form.goal)}}"
                bindchange="onGoalChange">
          <view class="value picker-value">
            {{form.goal}}<text class="arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="readonly">
        <text class="label">出勤率</text>
        <text class="value">{{profile.attendance_rate * 100}}%</text>
      </view>

      <button class="primary" loading="{{saving}}" disabled="{{saving}}" bindtap="save">
        {{saving ? '保存中…' : '保存'}}
      </button>
    </view>

    <view class="card">
      <view class="sec">我的数据权利</view>
      <view class="menu-item" bindtap="exportData">
        <text>查看 / 导出我的数据</text>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item danger" bindtap="deactivate">
        <text>注销账号</text>
        <text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="openAgreement">
        <text>用户协议与隐私政策</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="foot-note">
      姓名、手机号、健身目标由你自行维护；体测数据与训练计划由教练录入。
    </view>
  </block>
</view>
