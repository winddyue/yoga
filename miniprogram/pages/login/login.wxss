.login-page{min-height:100vh;background:#f5f7f6;padding:72rpx 44rpx 40rpx;box-sizing:border-box}.hero{text-align:center;margin-bottom:48rpx}.brand-mark{margin:0 auto 20rpx;width:104rpx;height:104rpx;line-height:104rpx;border-radius:32rpx;background:#147d73;color:#fff;font-size:52rpx;font-weight:700;box-shadow:0 14rpx 30rpx rgba(20,125,115,.2)}.brand{display:block;color:#173a38;font-size:38rpx;font-weight:700}.slogan{display:block;color:#8a9694;font-size:25rpx;margin-top:14rpx}.card{background:#fff;border-radius:28rpx;padding:42rpx 34rpx 34rpx;box-shadow:0 16rpx 50rpx rgba(32,72,68,.08)}.welcome{display:block;color:#173a38;font-size:42rpx;font-weight:700}.hint{display:block;color:#8a9694;font-size:25rpx;line-height:1.6;margin:12rpx 0 36rpx}.field{height:96rpx;border:2rpx solid #e7eeec;border-radius:16rpx;margin-bottom:22rpx;display:flex;align-items:center;padding:0 24rpx;box-sizing:border-box}.icon{width:42rpx;color:#147d73;font-size:24rpx}.field input{flex:1;font-size:29rpx}.placeholder{color:#aab5b2}.primary,.wechat{height:92rpx;line-height:92rpx;border-radius:16rpx;font-size:30rpx;font-weight:600}.primary{background:#147d73;color:#fff}.wechat{background:#edf8f3;color:#147d73}.split{display:flex;align-items:center;gap:18rpx;color:#a1aca9;font-size:24rpx;margin:30rpx 0}.split view{height:2rpx;background:#edf0ef;flex:1}.error{color:#c44f4f;background:#fff3f1;padding:18rpx;border-radius:12rpx;font-size:25rpx;margin-top:20rpx}.register-row{text-align:center;color:#8a9694;font-size:25rpx;margin-top:30rpx}.register-row text{color:#147d73;margin-left:8rpx}.account-note{display:block;text-align:center;color:#b0bab7;font-size:22rpx;margin-top:16rpx}.privacy{display:block;text-align:center;color:#aab5b2;font-size:22rpx;margin-top:28rpx}
