/* 饮食方案：复用 app.wxss 全局 token，此处仅补方案卡与餐单行 */
.gen-btn { margin: 0 0 8rpx; }
.diet-card { margin-top: 20rpx; padding: 26rpx 28rpx; }
.diet-head { display: flex; align-items: center; justify-content: space-between; }
.diet-head .t { font-size: 31rpx; font-weight: 600; margin-right: 14rpx; }
.diet-head .arrow { font-size: 32rpx; color: #85948F; }
.meal-line { padding: 12rpx 0; border-bottom: 2rpx solid #F6F1E8; }
.meal-label { display: block; font-size: 26rpx; font-weight: 600; }
.meal-items { display: block; font-size: 25rpx; color: #85948F; margin-top: 6rpx; line-height: 1.6; }
.btns { display: flex; gap: 16rpx; margin-top: 18rpx; }
