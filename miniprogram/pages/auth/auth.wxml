<view class="auth-page">
  <view class="hero">
    <view class="brand-mark">瑜</view>
    <text class="brand">瑜伽馆客户管理</text>
    <text class="slogan">记录每一次进步，陪伴每一次坚持</text>
  </view>

  <view class="card">
    <!-- ============ 主路径：微信一键登录 ============ -->
    <block wx:if="{{step === 'main'}}">
      <button class="primary wx" loading="{{loading}}" disabled="{{loading}}" bindtap="doWxLogin">
        {{loading ? '登录中…' : '微信一键登录'}}
      </button>
      <text class="cap-note">无需注册，首次进入仅需填写姓名</text>

      <view class="split"><view></view><text>或</text><view></view></view>

      <text class="hint">教练、馆主请使用账号密码登录</text>
      <view class="field">
        <text class="icon">人</text>
        <input placeholder="请输入用户名" placeholder-class="placeholder"
               data-k="username" value="{{username}}" bindinput="onInput" />
      </view>
      <view class="field">
        <text class="icon">锁</text>
        <input placeholder="请输入密码" placeholder-class="placeholder" password
               data-k="password" value="{{password}}" bindinput="onInput" />
      </view>
      <button class="primary ghost" loading="{{loading}}" disabled="{{loading}}" bindtap="doPwdLogin">
        {{loading ? '登录中…' : '登录'}}
      </button>
    </block>

    <!-- ============ 新用户：补全资料（极简建档） ============ -->
    <block wx:else>
      <text class="title-row">完善资料</text>
      <text class="hint">首次使用需登记姓名，便于预约与课堂点名</text>
      <view class="field">
        <text class="icon">人</text>
        <input placeholder="请填写姓名" placeholder-class="placeholder"
               data-k="name" value="{{name}}" bindinput="onInput" />
      </view>
      <view class="field">
        <text class="icon">机</text>
        <input type="number" maxlength="11" placeholder="手机号（选填，用于课程通知）"
               placeholder-class="placeholder" data-k="phone" value="{{phone}}" bindinput="onInput" />
      </view>
      <button class="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="doWxRegister">
        {{loading ? '提交中…' : '完成，进入小程序'}}
      </button>
      <text class="back-link" bindtap="backToMain">‹ 返回</text>
    </block>

    <view wx:if="{{err}}" class="error">{{err}}</view>

    <view class="agree">
      <view class="check {{agreed ? 'on' : ''}}" bindtap="toggleAgree">{{agreed ? '✓' : ''}}</view>
      <text>已阅读并同意
        <text class="link" data-t="terms" bindtap="openAgreement">《用户协议》</text>和
        <text class="link" data-t="privacy" bindtap="openAgreement">《隐私政策》</text>
      </text>
    </view>
  </view>

  <text class="back" bindtap="back">暂不登录，先逛逛</text>
</view>
