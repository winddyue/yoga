.auth-page{min-height:100vh;background:#f5f7f6;padding:72rpx 44rpx 40rpx;box-sizing:border-box}
.hero{text-align:center;margin-bottom:44rpx}
.brand-mark{margin:0 auto 20rpx;width:104rpx;height:104rpx;line-height:104rpx;border-radius:32rpx;background:#147d73;color:#fff;font-size:52rpx;font-weight:700;box-shadow:0 14rpx 30rpx rgba(20,125,115,.2)}
.brand{display:block;color:#173a38;font-size:38rpx;font-weight:700}
.slogan{display:block;color:#8a9694;font-size:25rpx;margin-top:14rpx}
.card{background:#fff;border-radius:28rpx;padding:34rpx 34rpx 30rpx;box-shadow:0 16rpx 50rpx rgba(32,72,68,.08)}
.tabs{display:flex;gap:44rpx;border-bottom:2rpx solid #eef2f0;margin-bottom:30rpx}
.tab{position:relative;padding:0 0 20rpx;color:#8a9694;font-size:30rpx}
.tab.on{color:#173a38;font-weight:700}
.tab.on::after{content:'';position:absolute;left:50%;bottom:-2rpx;transform:translateX(-50%);width:56rpx;height:6rpx;border-radius:6rpx;background:#147d73}
.hint{display:block;color:#8a9694;font-size:25rpx;line-height:1.6;margin:4rpx 0 28rpx}
.field{height:96rpx;border:2rpx solid #e7eeec;border-radius:16rpx;margin-bottom:22rpx;display:flex;align-items:center;padding:0 24rpx;box-sizing:border-box}
.icon{width:42rpx;color:#147d73;font-size:24rpx}
.field input{flex:1;font-size:29rpx}
.placeholder{color:#aab5b2}
.primary{height:92rpx;line-height:92rpx;border-radius:16rpx;font-size:30rpx;font-weight:600;background:#147d73;color:#fff}
.primary[disabled]{opacity:.7}
.dev{margin-top:26rpx;padding-top:22rpx;border-top:2rpx dashed #e7eeec}
.dev-toggle{display:block;color:#a9b4b1;font-size:23rpx}
.dev-input{height:84rpx;border:2rpx solid #e7eeec;border-radius:14rpx;margin:16rpx 0 10rpx;padding:0 22rpx;font-size:28rpx;box-sizing:border-box}
.dev-tip{display:block;color:#c0cac7;font-size:21rpx}
.cap-note{display:block;color:#b0bab7;font-size:21rpx;text-align:center;margin-top:14rpx}
.error{color:#c44f4f;background:#fff3f1;padding:18rpx;border-radius:12rpx;font-size:25rpx;margin-top:20rpx}
.agree{display:flex;align-items:center;gap:12rpx;margin-top:26rpx;color:#8a9694;font-size:23rpx}
.check{width:30rpx;height:30rpx;line-height:30rpx;text-align:center;border-radius:50%;border:2rpx solid #cfd8d5;color:#fff;font-size:20rpx;flex:none}
.check.on{background:#147d73;border-color:#147d73}
.back{display:block;text-align:center;color:#8a9694;font-size:26rpx;margin-top:40rpx}
