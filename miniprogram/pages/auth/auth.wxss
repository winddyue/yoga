.auth-page{min-height:100vh;background:#f5f7f6;padding:72rpx 44rpx 40rpx;box-sizing:border-box;display:flex;flex-direction:column}
.hero{text-align:center;margin-bottom:44rpx;flex:none}
.brand-mark{margin:0 auto 20rpx;width:104rpx;height:104rpx;line-height:104rpx;border-radius:32rpx;background:#147d73;color:#fff;font-size:52rpx;font-weight:700;box-shadow:0 14rpx 30rpx rgba(20,125,115,.2)}
.brand{display:block;color:#173a38;font-size:38rpx;font-weight:700}
.slogan{display:block;color:#8a9694;font-size:25rpx;margin-top:14rpx}
.card{background:#fff;border-radius:28rpx;padding:34rpx 34rpx 30rpx;box-shadow:0 16rpx 50rpx rgba(32,72,68,.08)}
.title-row{display:block;font-size:36rpx;font-weight:700;color:#173a38;margin-bottom:8rpx}
.hint{display:block;color:#8a9694;font-size:25rpx;line-height:1.6;margin:4rpx 0 28rpx}
.field{height:96rpx;border:2rpx solid #e7eeec;border-radius:16rpx;margin-bottom:22rpx;display:flex;align-items:center;padding:0 24rpx;box-sizing:border-box}
.icon{width:44rpx;color:#147d73;font-size:24rpx}
.field input{flex:1;font-size:29rpx}
.placeholder{color:#aab5b2}
.primary{height:92rpx;line-height:92rpx;border-radius:16rpx;font-size:30rpx;font-weight:600;background:#147d73;color:#fff}
.primary[disabled]{opacity:.7}
.primary.ghost{background:#edf8f3;color:#147d73}
.primary.wx{background:#07c160}
.cap-note{display:block;color:#b0bab7;font-size:22rpx;text-align:center;margin-top:16rpx}
.split{display:flex;align-items:center;gap:18rpx;color:#a1aca9;font-size:24rpx;margin:30rpx 0}
.split view{height:2rpx;background:#edf0ef;flex:1}
.back-link{display:block;text-align:center;color:#147d73;font-size:26rpx;margin-top:26rpx}
.error{color:#c44f4f;background:#fff3f1;padding:18rpx;border-radius:12rpx;font-size:25rpx;margin-top:20rpx}
.agree{display:flex;align-items:flex-start;gap:12rpx;margin-top:26rpx;color:#8a9694;font-size:23rpx;line-height:1.6}
.check{width:30rpx;height:30rpx;line-height:30rpx;text-align:center;border-radius:50%;border:2rpx solid #cfd8d5;color:#fff;font-size:20rpx;flex:none;margin-top:4rpx}
.check.on{background:#147d73;border-color:#147d73}
.agree .link{color:#147d73}
.back{display:block;text-align:center;color:#8a9694;font-size:26rpx;margin-top:40rpx;flex:none}
