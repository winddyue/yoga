<view class="register-page"><view class="top"><text class="back" bindtap="goBack">‹</text><text class="title">创建客户账号</text></view><text class="sub">注册后即可预约课程、查看训练记录</text><view class="card"><view class="field"><text>姓名</text><input placeholder="请输入姓名" data-k="name" bindinput="onInput" /></view><view class="field"><text>用户名</text><input placeholder="用于登录的账号" data-k="username" bindinput="onInput" /></view><view class="field"><text>密码</text><input password placeholder="至少 6 位密码" data-k="password" bindinput="onInput" /></view><button class="primary" loading="{{loading}}" bindtap="register">注册并登录</button><view wx:if="{{err}}" class="error">{{err}}</view></view><text class="tip">已有账号？<text bindtap="goBack">返回登录</text></text></view>
