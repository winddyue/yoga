.sec { font-size: 34rpx; font-weight: 700; margin: 10rpx 0 6rpx; }
.tip-text { font-size: 25rpx; color: #85948F; margin-bottom: 24rpx; display: block; }
.grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.cell { width: 31%; border-radius: 24rpx; padding: 26rpx 0 22rpx; text-align: center; border: 3rpx solid transparent; box-sizing: border-box; }
.cell.on { border-color: #4FA39B; }
.dot { width: 64rpx; height: 64rpx; border-radius: 50%; margin: 0 auto 12rpx; }
.nm { display: block; font-size: 26rpx; color: #2F3F3C; }
.tick { display: block; font-size: 22rpx; color: #357771; margin-top: 6rpx; }
