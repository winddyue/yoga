/* 全局基础样式：统一页面底色、文字与通用组件 */
page {
  background: #FAF6F1;
  color: #4A4239;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.container { padding: 24rpx 32rpx 40rpx; box-sizing: border-box; }
.title { font-size: 40rpx; font-weight: 700; color: #4A4239; }
.title-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }

.card {
  background: #fff; border-radius: 28rpx; padding: 28rpx;
  margin-bottom: 20rpx; box-shadow: 0 8rpx 26rpx rgba(122, 100, 84, .06);
}
.card .t { font-size: 31rpx; font-weight: 600; color: #4A4239; }
.card .sub { font-size: 25rpx; color: #776A5D; margin-top: 10rpx; }
.card .btns { display: flex; gap: 16rpx; margin-top: 20rpx; }

.sec { font-size: 28rpx; font-weight: 600; color: #4A4239; margin: 26rpx 0 14rpx; }
.tip { color: #776A5D; font-size: 26rpx; padding: 40rpx 0; text-align: center; }
.tip.err { color: #B4655F; }

.status { display: inline-block; font-size: 23rpx; padding: 6rpx 16rpx; border-radius: 28rpx; margin-top: 14rpx; }
.status.s-booked { background: #F9EFF0; color: #A25964; }
.status.s-waitlist { background: #FBF3E2; color: #96690F; }
.status.s-checked_in { background: #EFF4EB; color: #5D6A4E; }
.status.s-no_show { background: #FBF0EE; color: #B4655F; }
.status.s-cancelled { background: #F3EFE8; color: #776A5D; }

/* 未登录引导条（约课 / 训练页顶部） */
.login-bar {
  display: flex; align-items: center; justify-content: space-between;
  background: #F9EFF0; border-radius: 999rpx; padding: 22rpx 24rpx;
  margin: 16rpx 0 20rpx; color: #A25964; font-size: 25rpx;
}
.login-bar .go { font-weight: 600; }

/* 首页 */
.home-page { padding: 24rpx 32rpx 40rpx; box-sizing: border-box; }
.home-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 26rpx; }
.eyebrow { display: block; color: #776A5D; font-size: 24rpx; }
.home-head .title { display: block; margin-top: 8rpx; }
.avatar {
  width: 84rpx; height: 84rpx; line-height: 84rpx; text-align: center;
  border-radius: 28rpx; background: #A25964; color: #fff; font-size: 36rpx; font-weight: 700;
}
.guest-card { background: #fff; border-radius: 24rpx; padding: 44rpx 32rpx; text-align: center; box-shadow: 0 12rpx 34rpx rgba(122,100,84,.07); }
.guest-title { display: block; font-size: 34rpx; font-weight: 700; color: #4A4239; }
.guest-sub { display: block; font-size: 25rpx; color: #776A5D; margin: 14rpx 0 30rpx; }
.guest-btn { background: #A25964; color: #fff; border-radius: 999rpx; font-size: 30rpx; height: 88rpx; line-height: 88rpx; }
.goal-card { background: #A25964; border-radius: 24rpx; padding: 34rpx; color: #fff; box-shadow: 0 14rpx 34rpx rgba(162,89,100,.22); }
.goal-card .label { display: block; font-size: 24rpx; opacity: .8; }
.goal-card .goal { display: block; font-size: 38rpx; font-weight: 700; margin: 12rpx 0 8rpx; }
.goal-card .goal-sub { display: block; font-size: 23rpx; opacity: .8; }
.stats { display: flex; background: #fff; border-radius: 24rpx; margin-top: 22rpx; padding: 30rpx 0; box-shadow: 0 10rpx 30rpx rgba(122,100,84,.06); }
.stat { flex: 1; text-align: center; }
.stat-value { display: block; font-size: 38rpx; font-weight: 700; color: #4A4239; }
.stat-value .unit { font-size: 22rpx; margin-left: 4rpx; font-weight: 400; }
.stat-label { display: block; font-size: 23rpx; color: #776A5D; margin-top: 8rpx; }
.section-title { font-size: 28rpx; font-weight: 600; margin: 30rpx 0 14rpx; }
.action { display: flex; align-items: center; justify-content: space-between; background: #fff; border-radius: 28rpx; padding: 28rpx; box-shadow: 0 8rpx 26rpx rgba(122,100,84,.06); }
.action-title { display: block; font-size: 30rpx; font-weight: 600; color: #4A4239; }
.action-sub { display: block; font-size: 24rpx; color: #776A5D; margin-top: 8rpx; }
.action .arrow { color: #C4B7A3; font-size: 40rpx; }

/* 我的 */
.mine-page { padding: 24rpx 32rpx 40rpx; box-sizing: border-box; }
.header { display: flex; align-items: center; gap: 24rpx; background: #fff; border-radius: 24rpx; padding: 34rpx 28rpx; box-shadow: 0 10rpx 30rpx rgba(122,100,84,.06); }
.header .avatar { width: 104rpx; height: 104rpx; line-height: 104rpx; border-radius: 34rpx; font-size: 42rpx; }
.who { flex: 1; }
.who .name { display: block; font-size: 34rpx; font-weight: 700; color: #4A4239; }
.who .role { display: block; font-size: 24rpx; color: #776A5D; margin-top: 10rpx; }
.header .go { color: #A25964; font-size: 27rpx; font-weight: 600; }
.login-box { margin-top: 26rpx; }
.login-box .primary { background: #A25964; color: #fff; border-radius: 999rpx; font-size: 30rpx; height: 90rpx; line-height: 90rpx; }
.login-box .tip-text { display: block; text-align: center; color: #776A5D; font-size: 23rpx; margin-top: 18rpx; }
.menu { background: #fff; border-radius: 24rpx; margin-top: 26rpx; overflow: hidden; box-shadow: 0 10rpx 30rpx rgba(122,100,84,.06); }
.menu-item { display: flex; align-items: center; justify-content: space-between; padding: 30rpx 28rpx; font-size: 29rpx; color: #4A4239; border-bottom: 2rpx solid #F1E9DE; }
.menu-item:last-child { border-bottom: none; }
.menu-item .arrow { color: #C4B7A3; font-size: 34rpx; }
.menu-item.danger { color: #B4655F; }
.logout { margin-top: 40rpx; background: #fff; color: #B4655F; border-radius: 999rpx; font-size: 30rpx; height: 90rpx; line-height: 90rpx; }

/* 通用主按钮 */
.primary { background: #A25964; color: #fff; border-radius: 999rpx; font-size: 30rpx; height: 88rpx; line-height: 88rpx; margin-top: 28rpx; }
.primary[disabled] { background: #DCCFC2; color: #fff; }

/* 表单行（个人信息编辑） */
.field { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 2rpx solid #F1E9DE; }
.field .label { width: 170rpx; font-size: 28rpx; color: #776A5D; }
.field .value { flex: 1; font-size: 29rpx; color: #4A4239; }
.field .picker-value { display: flex; align-items: center; justify-content: space-between; }
.readonly { display: flex; align-items: center; padding: 22rpx 0; }
.readonly .label { width: 170rpx; font-size: 28rpx; color: #776A5D; }
.readonly .value { flex: 1; font-size: 29rpx; color: #776A5D; }
.arrow { color: #C4B7A3; font-size: 34rpx; }

/* 页脚说明 */
.foot-note { color: #776A5D; font-size: 23rpx; text-align: center; padding: 32rpx 20rpx 0; line-height: 1.6; }
.tip-sub { color: #776A5D; font-size: 24rpx; margin-top: 12rpx; }

/* 记录页 tab */
.tabs { display: flex; background: #fff; border-radius: 28rpx; padding: 8rpx; margin-bottom: 20rpx; box-shadow: 0 8rpx 26rpx rgba(122,100,84,.06); }
.tab { flex: 1; text-align: center; padding: 20rpx 0; font-size: 28rpx; color: #776A5D; border-radius: 999rpx; }
.tab.on { background: #A25964; color: #fff; font-weight: 600; }

/* 关于我们 */
.about-hero { text-align: center; padding: 48rpx 28rpx; }
.brand-mark {
  width: 120rpx; height: 120rpx; line-height: 120rpx; margin: 0 auto 24rpx;
  border-radius: 36rpx; background: #A25964; color: #fff; font-size: 52rpx; font-weight: 700;
}
.gym-name { display: block; font-size: 36rpx; font-weight: 700; color: #4A4239; }
.gym-desc { display: block; font-size: 26rpx; color: #776A5D; margin-top: 18rpx; line-height: 1.7; text-align: left; }
.info-row { display: flex; padding: 22rpx 0; border-bottom: 2rpx solid #F1E9DE; font-size: 28rpx; }
.info-row:last-child { border-bottom: none; }
.info-row .label { width: 170rpx; color: #776A5D; }
.info-row .value { flex: 1; color: #4A4239; }
.info-row .value.link { color: #A25964; }
