/* 12 套界面主题覆写：根节点 class="t-{{theme}}" 生效。基准为薄荷青（G），故无 .t-g。
/* 由脚本生成，请勿手改；色值源自 utils/themes.js */

/* a · 山茶绿 */
.t-a .primary, .t-a .guest-btn, .t-a .login-box .primary, .t-a .foot .btn { background: #4C6043; }
.t-a .mine-page .avatar { background: #4C6043; }
.t-a .home-page .avatar { background: #EBEEE9; color: #4C6043; }
.t-a .goal-card { background: linear-gradient(135deg, #6F8563 0%, #4C6043 100%); box-shadow: 0 16rpx 32rpx rgba(76,96,67,.2); }
.t-a .tab.on, .t-a .tab-active { background: #4C6043; }
.t-a .check.on { background: #4C6043; border-color: #4C6043; }
.t-a .tab.on::after { background: #4C6043; }
.t-a .arrow, .t-a .header .go, .t-a .icon, .t-a .back-link, .t-a .agree .link, .t-a .info-row .value.link, .t-a .ring-pct { color: #4C6043; }
.t-a .brand-mark { background: #4C6043; }
.t-a .status.s-booked { background: #EBEEE9; color: #4C6043; }
.t-a .login-bar, .t-a .primary.ghost, .t-a .fi-blue { background: #EBEEE9; color: #4C6043; }
.t-a .home-page { background: #F5F7F2; }

